{
  "manifest": {
    "publishingInformation": {
      "locales": {
        "en-US": {
          "summary": "Auri is an intelligent virtual assistant powered by advanced AI.",
          "examplePhrases": [
            "Alexa, open auri",
            "Alexa, ask auri to help me",
            "Alexa, ask auri about the weather"
          ],
          "keywords": [
            "assistant",
            "AI",
            "intelligent",
            "gemini",
            "chat"
          ],
          "name": "Auri",
          "description": "Auri is your intelligent personal assistant. She can answer questions, help with tasks, control smart home devices, and much more. Powered by cutting-edge AI."
        }
      },
      "isAvailableWorldwide": true,
      "testingInstructions": "Say 'Alexa, open auri' to start. Then ask any question naturally.",
      "category": "KNOWLEDGE_AND_TRIVIA",
      "distributionCountries": []
    },
    "apis": {
      "custom": {
        "endpoint": {
          "uri": "arn:aws:lambda:us-east-1:ACCOUNT_ID:function:auri-skill"
        },
        "interfaces": [
          {
            "type": "ALEXA_PRESENTATION_APL",
            "supportedViewports": [
              {
                "mode": "HUB",
                "shape": "RECTANGLE",
                "minWidth": 1024,
                "maxWidth": 1280,
                "minHeight": 600,
                "maxHeight": 800
              },
              {
                "mode": "HUB",
                "shape": "RECTANGLE",
                "minWidth": 960,
                "maxWidth": 960,
                "minHeight": 480,
                "maxHeight": 480
              }
            ]
          }
        ]
      }
    },
    "manifestVersion": "1.0",
    "privacyAndCompliance": {
      "allowsPurchases": false,
      "locales": {
        "en-US": {
          "privacyPolicyUrl": "",
          "termsOfUseUrl": ""
        }
      },
      "isExportCompliant": true,
      "containsAds": false,
      "isChildDirected": false,
      "usesPersonalInfo": false
    },
    "permissions": []
  }
}
