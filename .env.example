# ========================================================
# JudgeGuard Core - 100% PRODUCT MODE Environment Config
# ========================================================
#
# IMPORTANT: This project strictly enforces 100% product mode.
# Mocks and simulations are FORBIDDEN. You MUST provide a valid API key.

# Gemini API Key (Required for Essence Drift and Semantic Analysis)
GEMINI_API_KEY="AIzaSy...your-gemini-api-key-here..."

# Optional: Multiple keys for automatic rotation and quota distribution
# GEMINI_API_KEYS="key1,key2,key3"

# JWT Secret for Auth0 Token Vault generation
JWT_SECRET="your-secure-random-jwt-secret-here"

# Web UI Server Port (Default: 8080)
PORT=8080
