# .dockerignore — root build context za sharpbet_core Docker build
# Ovo se odnosi na context: ../.. u docker-compose.yml

# Git & version control
.git
.git/**
.github
.github/**

# Node.js
node_modules
node_modules/**
package-lock.json
package.json
yarn.lock

# TypeScript / JS build artifacts
dist
dist/**
build
build/**
*.tsbuildinfo

# Python cache & artifacts
__pycache__
__pycache__/**
*.pyc
*.pyo
*.pyd
.pytest_cache
.pytest_cache/**
.mypy_cache
.mypy_cache/**
.eggs
eggs
*.egg-info
*.egg

# IDE & editor
.idea
.vscode
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs & temp
*.log
*.tmp
*.bak
*.pid
*.lock

# Environment & secrets
.env
.env.*
!.env.example

# Docker (don't nest Docker inside Docker)
Dockerfile*
docker-compose*
.dockerignore

# Large data directories
exports
exports/**
research
research/**
*.db
*.sqlite
*.sqlite3

# Docs (except README)
*.md
!README.md

# Test files
tests
tests/**

# OS files
.bak
*.tmp
Desktop.ini
Thumbs.db
ehthumbs.db

